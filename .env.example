# Fabric is local-only. Copy to .env and fill only the connections you need.
FABRIC_PORT=4188

# Direct Google consent. Create a Web application OAuth client, enable Calendar
# and/or Gmail API, and register http://127.0.0.1:4188/api/oauth/google/callback exactly.
# User consent happens in the browser; never put a Google password here.
# FABRIC_GOOGLE_CLIENT_ID=
# FABRIC_GOOGLE_CLIENT_SECRET=

# Optional callback relay for providers that refuse loopback callbacks (Notion, Slack):
# a public HTTPS origin serving relay/index.html. Not a secret. See docs/AUTH-ENGINE.md.
# FABRIC_PUBLIC_CALLBACK_BASE=https://connect.example.com

# Optional, per provider with a version 2 sign-in definition: testing (the default) or production. Picks the
# definition's consent policy; Google in testing asks for full access at sign-in, in production only what is required.
# FABRIC_GOOGLE_PUBLISHING=testing

# Optional model gateway: a public HTTPS chat-completions-compatible endpoint.
# Acquisition sends the entered goal + supplied documentation/schema metadata
# to this endpoint. Account credentials and execution results are not sent.
# FABRIC_MODEL_URL=
# FABRIC_MODEL_API_KEY=
# FABRIC_MODEL_NAME=

# Optional absolute data directory. Keep it private and backed up securely.
# FABRIC_DATA_DIR=
