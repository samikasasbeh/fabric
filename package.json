{
  "name": "capability-fabric",
  "version": "0.3.0",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "type": "module",
  "description": "Local-first capability acquisition and verified execution runtime",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "mcp": "node mcp.mts",
    "test": "node scripts/test.mjs",
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "verify:foundation": "npm run typecheck && npm run check && npm test",
    "status": "node cli.mjs status",
    "pipeline:example": "node cli.mjs pipeline build examples/integration-batch.json",
    "verify:public": "node scripts/verify-public-adapters.mjs",
    "verify:layer": "node scripts/test.mjs test/fabric-protocol.test.mjs",
    "browser:install": "playwright install chromium",
    "verify:sessions": "node scripts/test.mjs test/persistent-browser-live.test.mjs"
  },
  "dependencies": { "@modelcontextprotocol/server": "2.3.1", "playwright": "1.64.0" },
  "devDependencies": { "@modelcontextprotocol/client": "2.3.1", "@types/node": "24.0.0", "typescript": "5.9.3", "ajv": "8.20.0", "ajv-formats": "3.0.1" }
}
