      "end": "2026-10-20T14:00:00Z"
     },
     {
      "start": "2026-10-20T16:00:00Z",
      "end": "2026-10-20T18:00:00Z"
     },
     {
      "start": "2026-10-20T18:20:00Z",
      "end": "2026-10-20T20:40:00Z"
     }
    ]
   }
