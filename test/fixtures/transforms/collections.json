      {
       "email": "Guest@Example.com",
       "responseStatus": "tentative",
       "optional": true,
       "comment": "maybe"
      },
      {
       "email": "owner@example.com",
       "self": true,
       "responseStatus": "accepted"
      }
     ]
    },
    "add": [
     "guest@example.com",
     "New@example.com",
     "new@EXAMPLE.com"
    ],
    "remove": [],
    "owner": "owner@example.com"
   },
   "output": {
    "attendees": [
     {
      "email": "org@example.com",
      "organizer": true,
      "responseStatus": "accepted"
     },
     {
      "email": "Guest@Example.com",
      "responseStatus": "tentative",
      "optional": true,
      "comment": "maybe"
     },
     {
      "email": "owner@example.com",
      "self": true,
