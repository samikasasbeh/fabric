  {
   "name": "findBy matches one with ASCII folding",
   "transform": "collections.findBy@1",
   "input": {
    "list": {
     "results": [
      {
       "id": "U1",
       "email": "Ann@Example.com",
       "name": "Ann"
      },
      {
       "id": "U2",
       "email": "bob@example.com",
       "name": "Bob"
      },
      {
       "id": "U3",
       "email": "bob@example.com",
       "name": "Bobby"
      }
     ]
    },
    "items": "/results",
    "field": "/email",
    "id": "/id",
    "label": "/name",
    "value": "ann@example.com",
    "fold": "ascii",
    "require": "one"
   },
   "output": {
    "matches": [
     {
      "id": "U1",
      "label": "Ann"
     }
    ]
   }
  },
