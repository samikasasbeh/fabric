       "type": "number"
      },
      {
       "name": "Name",
       "id": "title",
       "type": "title"
      },
      {
       "name": "Stage",
       "id": "s%3B1",
       "type": "select"
      },
      {
       "name": "Tags",
       "id": "t1",
       "type": "multi_select"
      }
     ]
    },
    "where": {
     "Name": "Taxi",
     "Stage": "Open",
     "Cost": 3,
     "Tags": [
      "red",
      "blue"
     ]
    }
   },
   "output": {
    "filter": {
     "and": [
      {
       "property": "c1",
       "number": {
        "equals": 3
       }
      },
      {
       "property": "title",
       "title": {
        "contains": "Taxi"
       }
      },
      {
       "property": "s%3B1",
       "select": {
        "equals": "Open"
       }
      },
      {
       "property": "t1",
       "multi_select": {
        "contains": "red"
       }
      },
      {
       "property": "t1",
       "multi_select": {
        "contains": "blue"
       }
      }
     ]
    }
   }
  },
