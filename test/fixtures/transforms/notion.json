{
 "source": "Notion API reference (2026-03-11): page, data source and property objects, page property values, the data source query filter; refusals and the simulator-free choices are Fabric's own, named in each module",
 "cases": [
  {
   "name": "a page's title is its title property, every piece joined",
   "transform": "notion.title@1",
   "input": {
    "object": {
     "object": "page",
     "id": "a1b2c3d4-0000-4000-8000-000000000001",
     "properties": {
      "Name": {
       "id": "title",
       "type": "title",
       "title": [
        {
         "type": "text",
         "text": {
          "content": "Q4 "
         },
         "plain_text": "Q4 "
        },
        {
         "type": "text",
         "text": {
          "content": "plan"
         },
         "plain_text": "plan"
        }
       ]
      }
     }
    }
   },
   "output": {
    "title": "Q4 plan"
   }
  },
  {
   "name": "a data source's title is its own title, its title property being a schema",
   "transform": "notion.title@1",
   "input": {
    "object": {
     "object": "data_source",
     "id": "248104cd-477e-80af-bc30-000bd28de8f9",
     "title": [
      {
       "type": "text",
       "text": {
        "content": "Tasks"
       },
       "plain_text": "Tasks"
      }
     ],
     "properties": {
      "Name": {
       "id": "title",
       "name": "Name",
       "type": "title",
       "title": {}
      },
      "Cost": {
       "id": "c1",
       "name": "Cost",
       "type": "number",
       "number": {
        "format": "dollar"
       }
      },
      "Stage": {
       "id": "s%3B1",
       "name": "Stage",
       "type": "select",
       "select": {
        "options": [
         {
          "id": "o1",
          "name": "Open",
          "color": "green"
         },
         {
          "id": "o2",
          "name": "Closed",
          "color": "red"
         }
        ]
       }
      },
      "Tags": {
       "id": "t1",
       "name": "Tags",
       "type": "multi_select",
       "multi_select": {
        "options": [
         {
          "id": "g1",
          "name": "red"
         },
         {
          "id": "g2",
          "name": "blue"
         }
        ]
       }
      },
      "Total": {
       "id": "fo",
       "name": "Total",
       "type": "formula",
       "formula": {
        "expression": "prop(\"Cost\") * 2"
       }
      },
      "Files": {
       "id": "fi",
       "name": "Files",
       "type": "files",
       "files": {}
      }
     }
    }
   },
   "output": {
    "title": "Tasks"
   }
  },
