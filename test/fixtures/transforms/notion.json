  {
   "name": "one condition per property, naming its id: contains for text and list items, equals for the rest",
   "transform": "notion.filter@1",
   "input": {
    "schema": {
     "schema": {
      "type": "object",
      "properties": {
       "Cost": {
        "type": "number"
       },
       "Name": {
        "type": "string",
        "maxLength": 200000
       },
       "Stage": {
        "type": "string",
        "enum": [
         "Open",
         "Closed"
        ]
       },
