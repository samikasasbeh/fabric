{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fabric integration intake manifest",
  "description": "Candidate-build metadata, not account authority, certification, or an executable grant. Runtime validation also enforces canonical public HTTPS origins, distinct owners, bounded JSON, and optional source hash matching.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "appId", "version", "source", "auth", "maintenance"],
  "properties": {
    "schemaVersion": {"const": 1},
    "appId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "version": {"type": "string", "maxLength": 64, "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "url", "allowedOrigins"],
      "properties": {
        "kind": {"const": "openapi"},
        "url": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://"},
        "allowedOrigins": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "format": "uri", "maxLength": 2048, "pattern": "^https://"}},
        "sourceHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "auth": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": {"kind": {"enum": ["oauth2", "api-key", "none"]}}
    },
    "maintenance": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "backupOwner", "tier", "reviewIntervalDays"],
      "properties": {
        "owner": {"type": "string", "minLength": 1, "maxLength": 160},
        "backupOwner": {"type": "string", "minLength": 1, "maxLength": 160},
        "tier": {"enum": ["pilot", "standard"]},
        "reviewIntervalDays": {"type": "integer", "minimum": 1, "maximum": 365}
      }
    }
  }
}
