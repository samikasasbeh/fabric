{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabric:trigger:1",
  "title": "Fabric trigger file 1",
  "description": "The trigger format of docs/F10.9-BUILD-MAP.md section 8: one app's triggers as reviewed data. It documents the file shape for editors and reviewers. validateTriggerFile() in lib/triggers.mjs is the authority: it adds the expression grammar, step placement on reviewed read rows and registration members, the cursor rules, the registration id and destination rules, the event bounds and the id hash. lib/action-catalog.mjs loads these files from catalog/triggers, and a trigger stays a candidate until the status rule there passes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "appId", "specVersion", "reviewStatus", "pinnedParameters", "triggers"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "appId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "specVersion": { "const": "fabric/0.2" },
    "reviewStatus": { "enum": ["reviewed", "candidate"] },
    "pinnedParameters": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9._~-]{1,200}$" } },
    "superseded": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "replacedBy", "reason", "stopsAfter"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}\\.trigger\\.[a-z][a-z0-9-]{0,47}\\.v[1-9][0-9]{0,3}\\.[a-f0-9]{24}$" },
          "replacedBy": { "type": "object", "additionalProperties": false, "required": ["key", "version"], "properties": { "key": { "$ref": "#/$defs/key" }, "version": { "$ref": "#/$defs/version" } } },
          "reason": { "enum": ["safety", "change"] },
          "stopsAfter": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    },
    "triggers": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/trigger" } }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$" },
    "version": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "pointer": { "type": "string", "maxLength": 1000, "pattern": "^(/[^/]+)*$" },
    "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9-]{0,63}$" },
    "schema": {
      "type": "object", "required": ["type"], "description": "A closed JSON Schema in the compiler's subset (lib/compiler.mjs checkSchema).",
      "properties": { "type": { "enum": ["object", "array", "string", "integer", "number", "boolean", "null"] } }
    },
    "expr": {
      "type": "object", "minProperties": 1, "maxProperties": 4,
      "description": "One node of the closed expression grammar of lib/action-expressions.mjs: one grammar key and its named fields.",
      "propertyNames": { "enum": ["const", "input", "step", "pointer", "header", "item", "pick", "each", "as", "do", "max", "var", "account", "transform", "args", "object", "array", "concat", "when", "then", "either", "now", "jobKey", "cursor", "resolved", "receiver", "secret", "kept", "subscriptionKey"] }
    },
    "test": {
      "type": "object", "minProperties": 1, "maxProperties": 1,
      "propertyNames": { "enum": ["present", "absent", "nonEmpty", "equals", "status", "anyOf"] }
    },
    "expect": {
      "type": "object", "additionalProperties": false, "required": ["status", "require"],
      "properties": {
        "status": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "integer", "minimum": 100, "maximum": 599 } },
        "require": { "type": "array", "maxItems": 8, "items": { "type": "object" } }
      }
    },
    "exprMap": { "type": "object", "additionalProperties": { "$ref": "#/$defs/expr" } },
    "page": {
      "type": "object", "additionalProperties": false, "required": ["next", "into", "items", "max"],
      "properties": {
        "next": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["pointer"], "properties": { "pointer": { "$ref": "#/$defs/pointer" } } },
            { "type": "object", "additionalProperties": false, "required": ["link", "param"], "properties": { "link": { "const": "next" }, "param": { "type": "string" } } }
          ]
        },
        "into": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["query"], "properties": { "query": { "type": "string" } } },
            { "type": "object", "additionalProperties": false, "required": ["body"], "properties": { "body": { "$ref": "#/$defs/pointer" } } }
          ]
        },
        "items": { "$ref": "#/$defs/pointer" },
        "while": { "$ref": "#/$defs/pointer" },
        "max": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "readStep": {
      "type": "object", "additionalProperties": false, "required": ["id", "method", "path", "expect"],
      "description": "A poll, seed or enrich step: a read on a reviewed member of a read row.",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,31}$" },
        "method": { "enum": ["GET", "POST"] },
        "path": { "type": "string", "pattern": "^/" },
        "params": { "$ref": "#/$defs/exprMap" },
        "query": { "$ref": "#/$defs/exprMap" },
        "headers": { "$ref": "#/$defs/exprMap" },
        "body": { "$ref": "#/$defs/expr" },
        "page": { "$ref": "#/$defs/page" },
        "maxResponseBytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "registrationStep": {
      "type": "object", "additionalProperties": false, "required": ["id", "method", "path", "expect"],
      "description": "A register or teardown step, only on a member of REGISTRATION_MEMBERS (lib/triggers.mjs).",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,31}$" },
        "method": { "enum": ["POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "pattern": "^/" },
        "params": { "$ref": "#/$defs/exprMap" },
        "body": { "$ref": "#/$defs/expr" },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "keptRef": { "type": "object", "additionalProperties": false, "required": ["kept"], "properties": { "kept": { "$ref": "#/$defs/name" } } },
    "admission": {
      "type": "object", "additionalProperties": false, "required": ["scheme", "trust", "route"],
      "properties": {
        "scheme": { "enum": ["hmac-sha256-header", "channel-token", "notion-signature", "slack-v0", "socket-authenticated"] },
        "trust": { "const": "doorbell" },
        "handshake": { "enum": ["github-ping", "notion-verification-token", "slack-url-verification", "google-sync"] },
        "header": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
        "prefix": { "type": "string", "minLength": 1, "maxLength": 32 },
        "secret": { "type": "string" },
        "route": {
          "oneOf": [
            { "$ref": "#/$defs/keptRoute" },
            { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/keptRoute" } },
            { "type": "object", "additionalProperties": false, "required": ["pointer", "to"], "properties": { "pointer": { "$ref": "#/$defs/pointer" }, "to": { "const": "identity" } } },
            { "type": "object", "additionalProperties": false, "required": ["pointers", "to"], "properties": { "pointers": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/pointer" } }, "to": { "const": "identity" } } }
          ]
        },
        "wake": {
          "type": "object", "additionalProperties": false, "required": ["pointer"],
          "properties": { "pointer": { "$ref": "#/$defs/pointer" }, "equals": { "$ref": "#/$defs/expr" }, "in": { "$ref": "#/$defs/expr" } }
        },
        "collapse": { "type": "object", "minProperties": 1, "maxProperties": 1, "additionalProperties": false, "properties": { "header": { "type": "string" }, "pointer": { "$ref": "#/$defs/pointer" } } },
        "events": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{0,63}$" } }
      }
    },
    "keptRoute": { "type": "object", "additionalProperties": false, "required": ["header", "equals"], "properties": { "header": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" }, "equals": { "$ref": "#/$defs/keptRef" } } },
    "register": {
      "type": "object", "additionalProperties": false, "required": ["step", "keep"],
      "properties": {
        "step": { "$ref": "#/$defs/registrationStep" },
        "keep": { "type": "object", "minProperties": 1, "maxProperties": 8, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/pointer" } }
      }
    },
    "teardown": {
      "type": "object", "additionalProperties": false, "required": ["step", "onFailure"],
      "properties": { "step": { "$ref": "#/$defs/registrationStep" }, "onFailure": { "const": "record-leftover" } }
    },
    "delivery": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["method", "intervalSeconds"],
          "properties": {
            "method": { "const": "polling" },
            "intervalSeconds": { "type": "object", "additionalProperties": false, "required": ["default", "min"], "properties": { "default": { "type": "integer", "minimum": 30, "maximum": 86400 }, "min": { "type": "integer", "minimum": 30, "maximum": 86400 } } }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["method", "fallback", "register", "renew", "teardown", "admission"],
          "properties": {
            "method": { "const": "watch" },
            "fallback": { "const": "polling" },
            "register": { "$ref": "#/$defs/register" },
            "renew": {
              "type": "object", "additionalProperties": false, "required": ["lifetime", "at", "order", "onMiss"],
              "properties": {
                "lifetime": {
                  "oneOf": [
                    { "type": "object", "additionalProperties": false, "required": ["kept", "format"], "properties": { "kept": { "$ref": "#/$defs/name" }, "format": { "enum": ["epoch-ms-string", "rfc3339"] } } },
                    { "type": "object", "additionalProperties": false, "required": ["seconds"], "properties": { "seconds": { "type": "integer", "minimum": 60, "maximum": 2592000 } } }
                  ]
                },
                "at": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.9 },
                "order": { "const": "new-then-stop-old" },
                "onMiss": { "const": "resync" }
              }
            },
            "teardown": { "$ref": "#/$defs/teardown" },
            "admission": { "$ref": "#/$defs/admission" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["method", "registration", "fallback", "register", "teardown", "admission"],
          "properties": {
            "method": { "const": "webhook" }, "registration": { "const": "api" }, "fallback": { "const": "polling" },
            "register": { "$ref": "#/$defs/register" }, "teardown": { "$ref": "#/$defs/teardown" }, "admission": { "$ref": "#/$defs/admission" }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["method", "registration", "fallback", "admission"],
          "properties": { "method": { "const": "webhook" }, "registration": { "const": "operator" }, "fallback": { "const": "polling" }, "admission": { "$ref": "#/$defs/admission" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["method", "transport", "fallback", "admission"],
          "properties": {
            "method": { "const": "live" }, "transport": { "const": "slack-socket-mode" }, "fallback": { "const": "polling" }, "admission": { "$ref": "#/$defs/admission" },
            "alternative": {
              "type": "object", "additionalProperties": false, "required": ["method", "registration", "admission"],
              "properties": { "method": { "const": "webhook" }, "registration": { "const": "operator" }, "admission": { "$ref": "#/$defs/admission" } }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["method", "kind", "timeZone"],
          "properties": {
            "method": { "const": "builtin" }, "kind": { "const": "schedule" }, "timeZone": { "type": "string", "minLength": 1, "maxLength": 64 },
            "intervalSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 }, "cron": { "type": "string" }
          }
        }
      ]
    },
    "cursor": {
      "type": "object", "additionalProperties": false, "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,31}$" },
        "kind": { "enum": ["history-id@1", "sync-token@1", "high-water-time@1", "high-water-ts@1", "etag@1", "last-modified@1", "snapshot@1"] },
        "next": { "type": "object" },
        "compare": { "type": "string", "pattern": "^[a-z][a-z0-9]*\\.[a-z][A-Za-z0-9]*@[1-9][0-9]*$" },
        "lastPageOnly": { "const": true },
        "overlapSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "excludes": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "type": "string" } }
      }
    },
    "poll": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["source"],
          "description": "Reuses a read action's poll block.",
          "properties": {
            "source": {
              "type": "object", "additionalProperties": false, "required": ["action", "args"],
              "properties": {
                "action": { "type": "object", "additionalProperties": false, "required": ["key", "version"], "properties": { "key": { "$ref": "#/$defs/key" }, "version": { "$ref": "#/$defs/version" } } },
                "args": { "$ref": "#/$defs/exprMap" }
              }
            }
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["source", "items", "itemId", "itemVersion", "order", "cursors", "resync", "minIntervalSeconds"],
          "description": "The trigger's own read steps; the last is the poll step.",
          "properties": {
            "source": {
              "type": "object", "additionalProperties": false, "required": ["steps"],
              "properties": { "steps": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/readStep" } } }
            },
            "items": { "$ref": "#/$defs/expr" },
            "itemId": { "$ref": "#/$defs/expr" },
            "itemVersion": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pointer" }] },
            "itemTime": {
              "type": "object", "additionalProperties": false, "required": ["pointer", "format"],
              "properties": { "pointer": { "$ref": "#/$defs/pointer" }, "format": { "enum": ["rfc3339", "epoch-ms-string", "epoch-seconds", "slack-ts"] } }
            },
            "order": { "enum": ["asc", "desc", "unordered"] },
            "cursors": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "$ref": "#/$defs/cursor" } },
            "resync": {
              "type": "object", "additionalProperties": false, "required": ["statusIn"],
              "properties": { "statusIn": { "type": "array", "maxItems": 2, "uniqueItems": true, "items": { "enum": [404, 410] } } }
            },
            "minIntervalSeconds": { "type": "integer", "minimum": 30, "maximum": 86400 },
            "seed": {
              "type": "object", "additionalProperties": false, "required": ["step", "cursor"],
              "properties": {
                "step": { "$ref": "#/$defs/readStep" },
                "cursor": { "type": "object", "additionalProperties": false, "required": ["name", "pointer"], "properties": { "name": { "type": "string" }, "pointer": { "$ref": "#/$defs/pointer" } } }
              }
            },
            "enrich": {
              "type": "object", "additionalProperties": false, "required": ["max", "steps"],
              "properties": { "max": { "type": "integer", "minimum": 1, "maximum": 25 }, "steps": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "$ref": "#/$defs/readStep" } } }
            }
          }
        }
      ]
    },
    "trigger": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "key", "version", "name", "description", "delivery", "inputSchema", "resource", "poll", "dedupe", "event", "backfill", "retention", "bounds", "rows"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}\\.trigger\\.[a-z][a-z0-9-]{0,47}\\.v[1-9][0-9]{0,3}\\.[a-f0-9]{24}$" },
        "key": { "$ref": "#/$defs/key" },
        "version": { "$ref": "#/$defs/version" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "delivery": { "$ref": "#/$defs/delivery" },
        "inputSchema": { "$ref": "#/$defs/schema" },
        "choices": {
          "type": "array", "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["input", "source"],
            "properties": {
              "input": { "type": "string" }, "source": { "type": "string" },
              "dependsOn": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string" } },
              "args": { "type": "object" }
            }
          }
        },
        "resource": {
          "oneOf": [
            { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "type": "string" } },
            { "type": "object", "additionalProperties": false, "required": ["each", "as"], "properties": { "each": { "$ref": "#/$defs/pointer" }, "as": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,31}$" } } }
          ]
        },
        "poll": { "$ref": "#/$defs/poll" },
        "filter": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/test" } },
        "dedupe": {
          "type": "object", "additionalProperties": false, "required": ["kind"],
          "properties": {
            "kind": { "enum": ["id", "id+version", "content-hash"] },
            "fields": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/expr" } },
            "knownBy": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "$ref": "#/$defs/expr" } }
          }
        },
        "event": {
          "type": "object", "additionalProperties": false, "required": ["schema", "id", "occurredAt", "fields", "summary"],
          "properties": {
            "schema": { "$ref": "#/$defs/schema" },
            "id": { "$ref": "#/$defs/expr" },
            "occurredAt": { "$ref": "#/$defs/expr" },
            "fields": { "$ref": "#/$defs/exprMap" },
            "summary": {
              "type": "array", "maxItems": 8,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["label", "expr"],
                "properties": { "label": { "type": "string", "minLength": 1, "maxLength": 80 }, "expr": { "$ref": "#/$defs/expr" }, "truncate": { "type": "integer", "minimum": 1, "maximum": 1000 } }
              }
            }
          }
        },
        "backfill": {
          "type": "object", "additionalProperties": false, "required": ["default", "max"],
          "properties": { "default": { "const": 0 }, "max": { "type": "integer", "minimum": 0, "maximum": 25 } }
        },
        "retention": {
          "oneOf": [
            { "type": "object", "additionalProperties": false, "required": ["days"], "properties": { "days": { "type": "integer", "minimum": 1, "maximum": 7 } } },
            { "type": "object", "additionalProperties": false, "required": ["hours"], "properties": { "hours": { "type": "integer", "minimum": 1, "maximum": 24 } } }
          ]
        },
        "bounds": {
          "type": "object", "additionalProperties": false, "required": ["pages", "items", "pollSeconds"],
          "properties": { "pages": { "type": "integer", "minimum": 1, "maximum": 10 }, "items": { "type": "integer", "minimum": 1, "maximum": 500 }, "pollSeconds": { "type": "integer", "minimum": 1, "maximum": 10 } }
        },
        "rows": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "certified": {
          "type": "object", "additionalProperties": false, "required": ["evidence"],
          "properties": { "evidence": { "type": "string", "pattern": "^docs/live-evidence/[a-z][a-z0-9-]{0,63}/triggers\\.json$" } }
        }
      }
    }
  }
}
