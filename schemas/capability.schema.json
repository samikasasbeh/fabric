{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fabric:capability:0.1",
  "title": "Fabric HTTP capability 0.1",
  "description": "Portable, declarative capability, not an execution grant. lib/compiler.mjs enforces additional semantic restrictions, URL safety, schema limits, exact parameter mapping, method-derived effects, same-origin readback, and the immutable content hash. This schema is documentation/interoperability, not a substitute for that validator.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "specVersion", "version", "appId", "name", "description", "driver", "effect", "status", "inputSchema", "request", "provenance", "verification"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,199}$" },
    "specVersion": { "const": "fabric/0.1" },
    "version": { "const": 1 },
    "appId": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 10000 },
    "driver": { "const": "http" },
    "effect": { "enum": ["read", "write"] },
    "status": { "enum": ["candidate", "active", "disabled"] },
    "inputSchema": { "$ref": "#/$defs/inputSchema" },
    "request": { "$ref": "#/$defs/request" },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["kind", "fingerprint", "source"],
      "properties": {
        "kind": { "enum": ["openapi", "manual", "model"] },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source": { "type": "string", "maxLength": 2048 },
        "operationId": { "type": "string", "maxLength": 2048 },
        "path": { "type": "string", "maxLength": 2048 },
        "method": { "type": "string", "maxLength": 2048 }
      }
    },
    "verification": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "description"],
          "properties": { "kind": { "const": "response" }, "description": { "type": "string" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "request", "bindings", "assertions"],
          "properties": {
            "kind": { "const": "http-readback" },
            "description": { "type": "string" },
            "request": { "allOf": [{ "$ref": "#/$defs/request" }, { "properties": { "method": { "const": "GET" } } }] },
            "bindings": {
              "type": "object", "additionalProperties": {
                "type": "object", "additionalProperties": false, "required": ["from", "pointer", "schema"],
                "properties": { "from": { "enum": ["input", "response"] }, "pointer": { "$ref": "#/$defs/pointer" }, "schema": { "$ref": "#/$defs/inputSchema" } }
              }
            },
            "assertions": {
              "type": "array", "minItems": 1, "maxItems": 32,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["pointer"],
                "properties": { "pointer": { "$ref": "#/$defs/pointer" }, "equalsInput": { "$ref": "#/$defs/pointer" }, "equalsResponse": { "$ref": "#/$defs/pointer" }, "equals": {} },
                "oneOf": [{ "required": ["equalsInput"] }, { "required": ["equalsResponse"] }, { "required": ["equals"] }]
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "pointer": { "type": "string", "maxLength": 1024, "pattern": "^(|/.*)$" },
    "parameterNames": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" } },
    "request": {
      "type": "object", "additionalProperties": false, "required": ["method", "url"],
      "properties": {
        "method": { "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE", "OPTIONS"] },
        "url": { "type": "string", "maxLength": 8192, "pattern": "^https://" },
        "headers": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 256 } },
        "pathParameters": { "$ref": "#/$defs/parameterNames" },
        "queryParameters": { "$ref": "#/$defs/parameterNames" },
        "bodyParameter": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" }
      }
    },
    "inputSchema": {
      "type": "object", "additionalProperties": false, "required": ["type"],
      "properties": {
        "type": { "enum": ["object", "array", "string", "integer", "number", "boolean", "null"] },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/inputSchema" } },
        "required": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "additionalProperties": { "const": false },
        "items": { "$ref": "#/$defs/inputSchema" },
        "enum": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true },
        "const": {},
        "minimum": { "type": "number" }, "maximum": { "type": "number" },
        "exclusiveMinimum": { "type": "number" }, "exclusiveMaximum": { "type": "number" },
        "minLength": { "type": "integer", "minimum": 0, "maximum": 1000000 }, "maxLength": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "minItems": { "type": "integer", "minimum": 0, "maximum": 1000000 }, "maxItems": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "format": { "enum": ["date", "date-time", "email", "uuid", "uri", "int32", "int64", "float", "double"] },
        "description": { "type": "string" }, "title": { "type": "string" }, "default": {}, "examples": { "type": "array" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "object" } } }, "then": { "required": ["properties", "additionalProperties"] } },
        { "if": { "properties": { "type": { "const": "array" } } }, "then": { "required": ["items"] } }
      ]
    }
  }
}
