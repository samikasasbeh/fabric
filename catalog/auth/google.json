{
  "schemaVersion": 2,
  "providerId": "google",
  "displayName": "Google",
  "reviewStatus": "reviewed",
  "credentialEnvironment": {
    "clientId": "FABRIC_GOOGLE_CLIENT_ID",
    "clientSecret": "FABRIC_GOOGLE_CLIENT_SECRET"
  },
  "authorization": {
    "url": "https://accounts.google.com/o/oauth2/v2/auth",
    "pkce": "S256",
    "scopeParameter": "scope",
    "userScopeParameter": null,
    "loopbackRedirect": "allowed",
    "scopeSeparator": " ",
    "identityScopes": [
      "openid",
      "email"
    ],
    "extraParameters": {
      "access_type": "offline",
      "prompt": "consent"
    }
  },
  "token": {
    "url": "https://oauth2.googleapis.com/token",
    "encoding": "form",
    "clientAuthentication": "body",
    "responseFormat": "oauth2",
    "scopeSeparator": " ",
    "acceptedTokenTypes": [
      "bearer"
    ],
    "reconnectErrors": [
      "invalid_grant",
      "invalid_token"
    ],
    "requireExpiry": true,
    "maxLifetimeSeconds": 86400,
    "quirks": {
      "errorInSuccessBody": false,
      "errorCodeField": "error",
      "nullRefreshMeansNone": false,
      "basicEncoding": "form-urlencoded"
    }
  },
  "refresh": {
    "supported": true,
    "keepPreviousWhenOmitted": true
  },
  "revocation": {
    "url": "https://oauth2.googleapis.com/revoke",
    "method": "POST",
    "encoding": "form",
    "clientAuthentication": "none",
    "tokenParameter": "token",
    "preferredToken": "refresh",
    "successStatuses": [
      200
    ],
    "successRequire": [],
    "covers": "grant"
  },
  "apiHeaders": {},
  "identity": {
    "request": {
      "url": "https://openidconnect.googleapis.com/v1/userinfo",
      "method": "GET",
      "headers": {},
      "body": "none"
    },
    "require": [],
    "requireFailure": "unverifiable",
    "id": {
      "pointers": [
        "/sub"
      ],
      "separator": "",
      "allowNumbers": false
    },
    "alternateId": null,
    "displayName": {
      "pointers": [
        "/email",
        "/name"
      ],
      "fallback": "Google account"
    },
    "email": "/email",
    "attributes": {}
  },
  "apps": [
    {
      "appId": "google-calendar",
      "accessProbe": {
        "url": "https://www.googleapis.com/calendar/v3/users/me/calendarList?maxResults=1&fields=kind",
        "method": "GET"
      },
      "access": {
        "default": "full",
        "grant": "scope",
        "levels": {
          "full": {
            "required": [
              "https://www.googleapis.com/auth/calendar.events",
              "https://www.googleapis.com/auth/calendar.calendarlist"
            ],
            "optional": [
              "https://www.googleapis.com/auth/calendar.calendars",
              "https://www.googleapis.com/auth/calendar.acls",
              "https://www.googleapis.com/auth/calendar.settings.readonly",
              "https://www.googleapis.com/auth/calendar.freebusy"
            ],
            "inContext": []
          },
          "read": null
        }
      },
      "neverRequest": [
        "https://www.googleapis.com/auth/calendar"
      ]
    },
    {
      "appId": "gmail",
      "accessProbe": {
        "url": "https://gmail.googleapis.com/gmail/v1/users/me/profile?fields=emailAddress",
        "method": "GET"
      },
      "access": {
        "default": "full",
        "grant": "scope",
        "levels": {
          "full": {
            "required": [
              "https://www.googleapis.com/auth/gmail.modify"
            ],
            "optional": [
              "https://www.googleapis.com/auth/gmail.settings.basic"
            ],
            "inContext": []
          },
          "read": {
            "required": [
              "https://www.googleapis.com/auth/gmail.readonly"
            ],
            "optional": []
          }
        }
      },
      "neverRequest": [
        "https://mail.google.com/",
        "https://www.googleapis.com/auth/gmail.settings.sharing",
        "https://www.googleapis.com/auth/gmail.metadata",
        "https://www.googleapis.com/auth/gmail.insert"
      ]
    }
  ],
  "scopeImplications": {},
  "consentPolicy": {
    "testing": "full",
    "production": "required"
  }
}
