{
 "schemaVersion": 1,
 "appId": "google-calendar",
 "triggers": true,
 "note": "Calendar's trigger pass, the TC tests of docs/I07-BUILD-MAP.md section 8, on two run calendars A and B, on the certification Fabric, run with --triggers --leave. Calendars and events stay, marked synthetic: a run deletes no calendar. One event reaches several watches, so each test polls every watch a write reaches. TC-guest, TC-share, TC-hide and TC-never are your hand steps, together. TC-soon's two tests are the only ones whose dates fall inside the next hour, and no other watch polls in them. TC-replay holds probe P1, TC-move P7, TC-guest P4, TC-invite P5 and P8, TC-cancel P6, and every poll's `within` P9. Google gives no way to expire a token, so no test ages a cursor. If probe P3 answers 410, add one.",
 "recorded": {
  "secondGuest": "The address of your second test account, which TC-guest invites and which answers by hand."
 },
 "readRows": [
  "google-calendar.events.read",
  "google-calendar.calendars.read",
  "google-calendar.settings.read"
 ],
 "timeZone": {
  "path": "/users/me/settings/timezone",
  "pointer": "/value"
 },
 "tests": [
  {
   "id": "TW1",
   "name": "Watch the calendar list before the run makes its calendars",
   "steps": [
    {
     "watch": {
      "trigger": "calendar-list-changed@1",
      "args": {},
      "save": {
       "list": "/id"
      }
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "list"
      },
      "events": 0
     }
    }
   ]
  },
  {
   "id": "TC-list",
   "name": "Two new calendars give exactly two list events, each with its owner role",
   "steps": [
    {
     "call": {
      "action": "create-calendar@1",
      "args": {
       "summary": {
        "$text": "calendar A"
       },
       "timeZone": {
        "$owner": "timeZone"
       }
      },
      "save": {
       "calendarA": "/id"
      }
     }
    },
    {
     "call": {
      "action": "create-calendar@1",
      "args": {
       "summary": {
        "$text": "calendar B"
       },
       "timeZone": {
        "$owner": "timeZone"
       }
      },
      "save": {
       "calendarB": "/id"
      }
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "list"
      },
      "events": 2,
      "within": 120,
      "checks": [
       {
        "pointer": "/events",
        "where": {
         "/fields/calendarId": {
          "$saved": "calendarA"
         }
        },
        "field": "/fields/accessRole",
        "equals": "owner"
       },
       {
        "pointer": "/events",
        "where": {
         "/fields/calendarId": {
          "$saved": "calendarB"
         }
        },
        "field": "/fields/accessRole",
        "equals": "owner"
       }
      ]
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "list"
      },
      "events": 0
     }
    }
   ],
   "undo": {
    "none": "The two calendars stay, marked synthetic: deleting one takes the owner's one-time Ask, and a run leaves what it makes."
   }
  },
