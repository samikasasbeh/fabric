     "read": {
      "path": "/calendars/{cal}/events",
      "params": {
       "cal": {
        "$saved": "calendarA"
       }
      },
      "save": {
       "replayToken": "/nextSyncToken"
      },
      "checks": [
       {
        "status": 200
       }
      ]
     }
    },
    {
     "call": {
      "action": "create-event@1",
      "args": {
       "calendarId": {
        "$saved": "calendarA"
       },
       "kind": "timed",
       "summary": {
        "$text": "meet"
       },
       "start": {
        "$local": {
         "day": 9,
         "time": "11:00"
        }
       },
       "end": {
