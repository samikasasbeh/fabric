{
 "schemaVersion": 1,
 "appId": "notion",
 "triggers": true,
 "note": "Notion's trigger pass, T1 to T8 of docs/I07-BUILD-MAP.md section 8, on pages A and B, the recorded database and row 1, on the certification Fabric, run with --triggers --leave. What it makes stays, marked synthetic. Your two hand steps are the image of T3, before the watches, and the row of T8, last. T2 answers probe P1, T3 P9, T4 P5 in the two stamps it saves, T5 P7, T6 P8 and T7 P6, and every poll's `within` holds P2.",
 "recorded": {
  "pageA": "The id of page A, a top page whose title starts with [SYNTHETIC], shared with Fabric's integration.",
  "pageB": "The id of page B, a second top page whose title starts with [SYNTHETIC], shared the same way.",
  "database": "The id of the synthetic database under page A, shared the same way.",
  "dataSource": "The id of that database's one data source, as Describe database lists it.",
  "row1": "The id of the database's first row, whose Count is 1 before the run."
 },
 "readRows": [
  "notion.content.read",
  "notion.comments.read"
 ],
 "tests": [
  {
   "id": "TS",
   "name": "Make the two pages the watches name, and put one image on page B",
   "steps": [
    {
     "call": {
      "action": "create-page@1",
      "args": {
       "parent": {
        "$recorded": "pageA"
       },
       "title": {
        "$text": "content page"
       },
       "content": {
        "$text": "first line"
       }
      },
      "save": {
       "contentPage": "/id"
      }
     }
    },
    {
     "call": {
      "action": "create-page@1",
      "args": {
       "parent": {
        "$recorded": "pageA"
       },
       "title": {
        "$text": "trash page"
       }
      },
      "save": {
       "trashPage": "/id"
      }
     }
    },
    {
     "owner": {
      "words": "In Notion, add one small image to page B if it holds none, once, then press Enter. T3 reads that page twice, and a signed link that changes must not read as a change."
     }
    }
   ],
   "undo": {
    "none": "The two pages stay under A, marked synthetic."
   }
  },
  {
   "id": "TW",
   "name": "Watch six sources. Each baseline stores nothing",
   "steps": [
    {
     "watch": {
      "trigger": "new-row@1",
      "args": {
       "dataSourceId": {
        "$recorded": "dataSource"
       }
      },
      "save": {
       "newRow": "/id"
      }
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "newRow"
      },
      "events": 0
     }
    },
    {
     "watch": {
      "trigger": "page-content-changed@1",
      "args": {
       "pages": [
        {
         "$saved": "contentPage"
        },
        {
         "$recorded": "pageB"
        }
       ]
      },
      "save": {
       "content": "/id"
      }
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "content"
      },
      "events": 0
     }
    },
    {
     "watch": {
      "trigger": "new-comment@1",
      "args": {
       "pages": [
        {
         "$recorded": "pageA"
        }
       ]
      },
      "save": {
       "comments": "/id"
      }
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "comments"
      },
      "events": 0
     }
    },
    {
     "watch": {
      "trigger": "trashed-or-restored@1",
      "args": {
       "pages": [
        {
         "$saved": "trashPage"
        }
       ]
      },
      "save": {
       "trash": "/id"
      }
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "trash"
      },
      "events": 0
     }
    },
    {
     "watch": {
      "trigger": "schema-changed@1",
      "args": {
       "dataSourceId": {
        "$recorded": "dataSource"
       }
      },
      "save": {
       "schema": "/id"
      }
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "schema"
      },
      "events": 0
     }
    },
    {
     "watch": {
      "trigger": "new-child-page@1",
      "args": {
       "pages": [
        {
         "$recorded": "pageA"
        },
        {
         "$recorded": "pageB"
        }
       ]
      },
      "save": {
       "children": "/id"
      }
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "children"
      },
      "events": 0
     }
    }
   ]
  },
  {
   "id": "T1",
   "name": "A new row gives one event, a re-poll none, and an old row edited none after 90 seconds",
   "steps": [
    {
     "call": {
      "action": "add-row@1",
      "args": {
       "dataSource": {
        "$recorded": "dataSource"
       },
       "values": {
        "Name": {
         "$text": "row"
        },
        "Stage": "Open",
        "Count": 2
       }
      },
      "save": {
       "row": "/id"
      },
      "checks": [
       {
        "pointer": "/parentType",
        "equals": "data_source_id"
       }
      ]
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "newRow"
      },
      "events": 1,
      "within": 120,
      "checks": [
       {
        "pointer": "/events/0/fields/pageId",
        "equals": {
         "$saved": "row"
        }
       },
       {
        "pointer": "/events/0/fields/title",
        "equals": {
         "$text": "row"
        }
       }
      ]
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "newRow"
      },
      "events": 0,
      "itemsRead": 1
     }
    },
    {
     "call": {
      "action": "update-row@1",
      "args": {
       "page": {
        "$recorded": "row1"
       },
       "values": {
        "Count": 5
       }
      }
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "newRow"
      },
      "events": 0,
      "within": 90
     }
    }
   ],
   "undo": {
    "steps": [
     {
      "call": {
       "action": "update-row@1",
       "args": {
        "page": {
         "$recorded": "row1"
        },
        "values": {
         "Count": 1
        }
       }
      }
     }
    ]
   }
  },
