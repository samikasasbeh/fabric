  {
   "id": "TH2",
   "name": "An issue opened gives one event and its close one more, and the last of two re-polls is a 304",
   "steps": [
    {
     "call": {
      "action": "create-issue@1",
      "args": {
       "repository": "samikasasbeh/fabric-sandbox-test",
       "title": {
        "$text": "issue"
       }
      },
      "save": {
       "issue": "/number"
      }
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "issues"
      },
      "events": 1,
      "within": 120,
      "checks": [
       {
        "pointer": "/events/0/fields/number",
        "equals": {
         "$saved": "issue"
        }
       },
       {
        "pointer": "/events/0/fields/state",
        "equals": "open"
       }
      ]
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "issues"
      },
      "events": 0
     }
    },
    {
     "call": {
      "action": "update-issue@1",
      "args": {
       "repository": "samikasasbeh/fabric-sandbox-test",
       "number": {
        "$saved": "issue"
       },
       "state": "closed",
       "closeAs": "not_planned"
      },
      "checks": [
       {
        "pointer": "/state",
        "equals": "closed"
       }
      ]
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "issues"
      },
      "events": 1,
      "within": 120,
      "checks": [
       {
        "pointer": "/events/0/fields/state",
        "equals": "closed"
       },
       {
        "pointer": "/events/0/fields/stateReason",
        "equals": "not_planned"
       }
      ]
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "issues"
      },
      "events": 0
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "issues"
      },
      "events": 0,
      "checks": [
       {
        "status": 304
       }
      ]
     }
    }
   ],
   "undo": {
    "none": "The issue stays closed in the sandbox, marked synthetic."
   }
