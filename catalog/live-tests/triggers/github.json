{
 "schemaVersion": 1,
 "appId": "github",
 "triggers": true,
 "note": "GitHub's trigger pass, TH1 to TH9 of docs/I07-BUILD-MAP.md section 8, on samikasasbeh/fabric-sandbox-test and this run's branches, on the certification Fabric, run with --triggers --leave. What it makes stays there, marked synthetic. Your one hand step is the notification setting, first. TH4 answers probes 4 and 5, TH5 how long /activity takes to list a change, and TH7 probe 9 and the wait GitHub names. TH6 and TH8 save the newest run and release, which answers the first half of probe 7. Probes 1 to 3 run first through github.probes.json.",
 "recorded": {},
 "readRows": [
  "github.issues.read",
  "github.repos.read",
  "github.profile.read"
 ],
 "tests": [
  {
   "id": "TS",
   "name": "Have GitHub tell you of workflow runs",
   "steps": [
    {
     "owner": {
      "words": "In GitHub, open Settings, Notifications, System, Actions, and turn on On GitHub for every run, not only failed ones, once, then press Enter."
     }
    }
   ]
  },
