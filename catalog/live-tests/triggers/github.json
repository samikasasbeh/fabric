  {
   "id": "TH5",
   "name": "A branch made, a push and a branch deleted give one event each. This reads how long /activity takes",
   "steps": [
    {
     "call": {
      "action": "create-branch@1",
      "args": {
       "repository": "samikasasbeh/fabric-sandbox-test",
       "name": {
        "$branch": "push"
       },
       "from": "main"
      },
      "checks": [
       {
        "pointer": "/sha",
        "present": true
       }
      ]
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "pushes"
      },
      "events": 1,
      "within": 300,
      "checks": [
       {
        "pointer": "/events/0/fields/activityType",
        "equals": "branch_creation"
       }
      ]
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "pushes"
      },
      "events": 0
     }
    },
    {
     "call": {
      "action": "put-file@1",
      "args": {
       "repository": "samikasasbeh/fabric-sandbox-test",
       "path": "fabric-live/th5.md",
       "branch": {
        "$branch": "push"
       },
       "message": {
        "$text": "add a file"
       },
       "content": {
        "$text": "file"
       }
      }
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "pushes"
      },
      "events": 1,
      "within": 300,
      "checks": [
       {
        "pointer": "/events/0/fields/activityType",
        "equals": "push"
       }
      ]
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "pushes"
      },
      "events": 0
     }
    },
    {
     "ask": {
      "row": "github.code.write",
      "requests": [
       {
        "method": "DELETE",
        "path": "/repos/samikasasbeh/fabric-sandbox-test/git/refs/heads/{+branch}",
        "params": {
         "branch": {
          "$branch": "push"
         }
        }
       }
      ]
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "pushes"
      },
      "events": 1,
      "within": 300,
      "checks": [
       {
        "pointer": "/events/0/fields/activityType",
        "equals": "branch_deletion"
       }
      ]
     }
    },
    {
     "poll": {
      "subscription": {
       "$saved": "pushes"
      },
      "events": 0
     }
    }
   ],
   "undo": {
    "none": "The test's last write deletes its own branch, and its commit stays in GitHub's record."
   }
  },
