{
 "schemaVersion": 1,
 "appId": "github",
 "probes": true,
 "note": "Read probes 1, 2 and 3 of docs/I07-BUILD-MAP.md section 6, on the sandbox repository, run before the GitHub simulator grows in step 6. Each test is one question: yes means its checks hold. X-Poll-Interval does not come back through the proxy, so probe 1 cannot read it here, and step 9 does. How long /activity takes to list a push needs a write, so step 9 does that too. Answers go in section 12 by hand.",
 "recorded": {},
 "readRows": [
  "github.repos.read",
  "github.issues.read",
  "github.profile.read"
 ],
 "tests": [
  {
   "id": "N1",
   "name": "Does GET /notifications answer the OAuth App token with 200 and Last-Modified? No or a 401 or 403 means notification does not ship.",
   "steps": [
    {
     "read": {
      "path": "/notifications",
      "query": {
       "all": "true",
       "per_page": "1"
      },
      "headers": {
       "Accept": "application/vnd.github+json"
      },
      "checks": [
       {
        "status": 200
       },
       {
        "header": "last-modified",
        "present": true
       }
      ],
      "saveHeaders": {
       "modified": "/last-modified"
      }
     }
    }
   ]
  },
  {
   "id": "N2",
   "name": "Is the next read with If-Modified-Since a 304?",
   "steps": [
    {
     "read": {
      "path": "/notifications",
      "query": {
       "all": "true",
       "per_page": "1"
      },
      "headers": {
       "Accept": "application/vnd.github+json",
       "If-Modified-Since": {
        "$saved": "modified"
       }
      },
      "checks": [
       {
        "status": 304
       }
      ]
     }
    }
   ]
  },
  {
   "id": "N3",
   "name": "With since set as well, is it still a 304?",
   "steps": [
    {
     "read": {
      "path": "/notifications",
      "query": {
       "all": "true",
       "per_page": "1",
       "since": "2026-01-01T00:00:00Z"
      },
      "headers": {
       "Accept": "application/vnd.github+json",
       "If-Modified-Since": {
        "$saved": "modified"
       }
      },
      "checks": [
       {
        "status": 304
       }
      ]
     }
    }
   ]
  },
  {
